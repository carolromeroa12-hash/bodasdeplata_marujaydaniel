<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bodas de Plata | Maruja & Daniel</title>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Montserrat:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        :root {
            --primary: #111111;
            --accent: #d4af37;
            --bg-light: #fcfcfc;
            --text-dark: #2c2c2c;
            --text-muted: #666666;
            --card-bg: #ffffff;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background-color: var(--bg-light);
            color: var(--text-dark);
            line-height: 1.6;
            overflow-x: hidden;
        }

        h1, h2, h3, .brand-font {
            font-family: 'Cinzel', serif;
            letter-spacing: 2px;
        }

        .reveal {
            opacity: 0;
            transform: translateY(40px);
            transition: all 0.9s ease-out;
        }

        .reveal.active {
            opacity: 1;
            transform: translateY(0);
        }

        .wrapper {
            max-width: 500px;
            margin: 0 auto;
            background: #ffffff;
            box-shadow: 0 0 25px rgba(0,0,0,0.05);
            min-height: 100vh;
            position: relative;
        }

        .section {
            padding: 50px 25px;
            text-align: center;
            border-bottom: 1px solid #f0f0f0;
        }

        .divider {
            width: 50px;
            height: 1px;
            background-color: var(--accent);
            margin: 20px auto;
        }

        .hero {
            background: linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.6)), url('https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=800&q=80') center/cover no-repeat;
            color: #ffffff;
            padding: 90px 20px 60px 20px;
            min-height: 85vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

        .hero h3 {
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 4px;
            margin-bottom: 15px;
            color: var(--accent);
        }

        .hero h1 {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 15px;
        }

        .hero-quote {
            font-style: italic;
            font-size: 0.95rem;
            max-width: 90%;
            margin-top: 20px;
            opacity: 0.9;
        }

        .countdown-container {
            display: flex;
            justify-content: center;
            gap: 12px;
            margin: 25px 0;
        }

        .time-box {
            background: #f8f8f8;
            border: 1px solid #e5e5e5;
            padding: 12px 8px;
            border-radius: 6px;
            min-width: 65px;
        }

        .time-box span {
            display: block;
            font-size: 1.4rem;
            font-weight: 700;
            color: var(--primary);
        }

        .time-box label {
            font-size: 0.65rem;
            text-transform: uppercase;
            color: var(--text-muted);
            letter-spacing: 1px;
        }

        .btn {
            display: inline-block;
            background: var(--primary);
            color: #ffffff;
            padding: 12px 28px;
            text-decoration: none;
            border-radius: 30px;
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: all 0.3s ease;
            margin-top: 15px;
            border: 1px solid var(--primary);
        }

        .btn-outline {
            background: transparent;
            color: var(--primary);
            border: 1px solid var(--primary);
        }

        .btn i {
            margin-right: 8px;
        }

        .card {
            background: var(--card-bg);
            border: 1px solid #eaeaea;
            padding: 25px 20px;
            border-radius: 8px;
            margin-bottom: 25px;
        }

        .card-icon {
            font-size: 1.8rem;
            color: var(--accent);
            margin-bottom: 12px;
        }

        .inspo-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
            margin-top: 20px;
        }

        .inspo-grid img {
            width: 100%;
            height: 180px;
            object-fit: cover;
            border-radius: 6px;
        }

        .gallery-preview {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 8px;
            margin-top: 15px;
        }

        .gallery-preview img {
            width: 100%;
            height: 120px;
            object-fit: cover;
            border-radius: 4px;
        }

        footer {
            text-align: center;
            padding: 30px 20px;
            font-size: 0.8rem;
            color: var(--text-muted);
            background: #f4f4f4;
        }
    </style>
</head>
<body>

